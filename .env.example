VITE_API_BASE_URL=http://localhost:8000
# Public PayPal client ID only; all secrets stay server-side.
VITE_PAYPAL_CLIENT_ID=

# Server-side settings (configure in the API host, not in Vite/browser variables)
ENVIRONMENT=development
AVELUNE_ALLOWED_ORIGINS=http://localhost:5173

# AWS Cognito User Pool settings. These are server-side API environment variables.
# Never add AWS access keys, Cognito app-client secrets, or database credentials here.
AWS_COGNITO_REGION=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_APP_CLIENT_ID=
